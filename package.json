{
  "name": "sketchsync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server \"vite\" \"npm --prefix server run dev\"",
    "client:dev": "vite",
    "server:dev": "npm --prefix server run dev",
    "build": "tsc -b && npm run check:server && vite build",
    "check:server": "tsc --ignoreConfig --noEmit --target ES2022 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck --types node server/src/index.ts",
    "lint": "oxlint src server",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "lucide-react": "^1.63.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "oxlint": "^1.89.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
